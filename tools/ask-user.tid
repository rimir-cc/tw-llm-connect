title: $:/plugins/rimir/llm-connect/tools/ask-user
tags: $:/tags/rimir/llm-connect/tool
tool-name: ask_user
tool-description: Ask the user one or more questions and wait for the answers. Use it only when a decision is genuinely the user's to make (not for things you can find out or decide yourself). Batch related questions into a single call and give a 'default' where a sensible one exists. Question kinds: text (free text), choice (one of 'options'), multi (several of 'options'), confirm (yes/no). A 'default' is an option value for choice, 'yes'/'no' for confirm, and for multi a space-separated list of option values with values containing spaces in double square brackets (e.g. kind ports [[two words]]). The call may come back as 'declined' (user skipped it) or 'timeout' (no answer in time); then proceed with the defaults if given, or stop and summarise what you need.
tool-schema: {"type":"object","properties":{"heading":{"type":"string","description":"Short heading for the question set"},"intro":{"type":"string","description":"Optional markdown shown above the questions"},"questions":{"type":"array","minItems":1,"description":"The questions to ask","items":{"type":"object","properties":{"id":{"type":"string","description":"Short identifier used to label the answer"},"prompt":{"type":"string","description":"The question (markdown)"},"kind":{"type":"string","enum":["text","choice","multi","confirm"]},"options":{"type":"array","description":"For choice/multi","items":{"type":"object","properties":{"value":{"type":"string"},"label":{"type":"string"},"description":{"type":"string"}},"required":["value"]}},"allow_other":{"type":"boolean","description":"choice/multi: add a free-text 'Other' field"},"default":{"type":"string","description":"Pre-filled answer; used if the user does not answer in time. multi: space-separated option values, [[two words]] for values with spaces"},"required":{"type":"boolean"}},"required":["prompt","kind"]}}},"required":["questions"]}
tool-mode: action
tool-category: core
tool-await: yes
tool-result-template: $:/plugins/rimir/llm-connect/ui/ask-result
type: text/vnd.tiddlywiki

<$list filter="[<questions>minlength[1]]" variable="_" emptyMessage="Error: Missing 'questions' parameter"><$list filter="[<questions>jsontype[]match[array]]" variable="_" emptyMessage="Error: 'questions' must be a JSON array of question objects"><$list filter="[<questions>jsonindexes[]count[]compare:number:gt[0]]" variable="_" emptyMessage="Error: 'questions' must contain at least one question"><$action-setfield $tiddler=<<__awaitTitle>> text=<<questions>> ask.title=<<heading>> ask.intro=<<intro>> ask.status="pending" ask.source-label=<<__askSource>> ask.created=<<__timestamp>>/><$list filter="[<questions>jsonindexes[]]" variable="i"><$list filter="[<questions>jsonget<i>,[default]minlength[1]]" variable="d"><$action-setfield $tiddler=<<__awaitTitle>> $field={{{ [[ask.answer-]addsuffix<i>] }}} $value=<<d>>/></$list></$list>Waiting for the user's answer.</$list></$list></$list>
